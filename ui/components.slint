import { Palette, Switch } from "std-widgets.slint";
// Segoe Fluent Icons code points by default; hosts without that font substitute symbols.
export global Glyphs {
    in-out property <string> account: "\u{e77b}";
    in-out property <string> shortcut: "\u{e765}";
    in-out property <string> audio: "\u{e720}";
    in-out property <string> cleanup: "\u{e8fb}";
    in-out property <string> stats: "\u{e9d2}";
    in-out property <string> reset: "\u{e74d}";
    in-out property <string> general: "\u{e713}";
    in-out property <string> signed-in: "\u{e73e}";
    in-out property <string> signed-out: "\u{e7ba}";
    in-out property <string> language: "\u{e774}";
    in-out property <string> sounds: "\u{e767}";
    in-out property <string> lower-audio: "\u{e993}";
    in-out property <string> idle-pill: "\u{e890}";
    in-out property <string> startup: "\u{e7e8}";
    in-out property <string> context: "\u{e8a5}";
    in-out property <string> dictionary: "\u{e82d}";
}
export component Heading inherits Text { font-size: 28px; font-weight: 600; color: Palette.foreground; }
export component Description inherits Text { font-size: 12px; color: Palette.alternate-foreground; wrap: word-wrap; }
export component Card inherits Rectangle {
    vertical-stretch: 0;
    background: Palette.control-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 8px;
    VerticalLayout { padding: 20px; spacing: 8px; @children }
}
export component CardHeader inherits HorizontalLayout {
    in property <string> icon-font;
    in property <string> glyph;
    in property <string> title;
    in property <string> detail;
    spacing: 16px;
    Text { text: root.glyph; width: 20px; font-family: root.icon-font; font-size: 20px; color: Palette.foreground; vertical-alignment: center; }
    VerticalLayout {
        spacing: 5px;
        Text { text: root.title; font-size: 15px; font-weight: 600; color: Palette.foreground; }
        Description { text: root.detail; }
    }
}
export component ToggleCard inherits Card {
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.55;
    in property <string> icon-font;
    in property <string> glyph;
    in property <string> title;
    in property <string> detail;
    in-out property <bool> checked;
    callback toggled;
    HorizontalLayout {
        spacing: 16px;
        Text { text: root.glyph; width: 20px; font-family: root.icon-font; font-size: 20px; color: Palette.foreground; vertical-alignment: center; }
        VerticalLayout {
            spacing: 5px;
            Text { text: root.title; font-size: 15px; font-weight: 600; color: Palette.foreground; }
            Description { text: root.detail; }
        }
        Switch { enabled: root.enabled; checked <=> root.checked; text: checked ? "On" : "Off"; toggled => { root.toggled(); } }
    }
}
