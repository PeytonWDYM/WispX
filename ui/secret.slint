// Crossfades cached Gaussian glyph masks, then hands off to crisp native text.
export component SecretText inherits TouchArea {
    in property <string> text;
    in property <length> font-size: 15px;
    in property <int> font-weight: 400;
    in property <brush> color;
    in property <[image]> frames;
    in property <length> pad;
    in property <float> image-scale: 1;
    in-out property <bool> revealed: false;
    // Hover softens the blur slightly without exposing the sharp text.
    property <float> blur: root.revealed ? 0 : root.has-hover ? 0.85 : 1;
    animate blur { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <float> level: root.blur * (root.frames.length - 1);
    property <int> lower: floor(root.level);
    property <int> upper: min(root.lower + 1, root.frames.length - 1);
    property <float> mix: root.level - root.lower;
    property <float> sharp-opacity: max(0, 1 - root.level);
    preferred-width: sharp.preferred-width;
    preferred-height: sharp.preferred-height;
    mouse-cursor: pointer;
    clicked => { root.revealed = !root.revealed; }
    accessible-role: button;
    accessible-label: root.revealed ? root.text : "Hidden email, click to show";
    accessible-action-default => { root.revealed = !root.revealed; }
    if root.frames.length > 0: Image {
        x: -root.pad;
        y: -root.pad;
        source: root.frames[root.lower];
        width: self.source.width * 1px / root.image-scale;
        height: self.source.height * 1px / root.image-scale;
        colorize: root.color;
        opacity: (1 - root.mix) * (1 - root.sharp-opacity);
    }
    if root.frames.length > 0: Image {
        x: -root.pad;
        y: -root.pad;
        source: root.frames[root.upper];
        width: self.source.width * 1px / root.image-scale;
        height: self.source.height * 1px / root.image-scale;
        colorize: root.color;
        opacity: root.mix * (1 - root.sharp-opacity);
    }
    sharp := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.color;
        opacity: root.frames.length > 0 ? root.sharp-opacity : root.revealed ? 1 : 0;
    }
}
