<UserControl x:Class="WispX.AudioPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Audio" Style="{DynamicResource PageTitle}"/>
        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE720;" Style="{DynamicResource Glyph}"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Microphone" Style="{DynamicResource CardTitle}"/><TextBlock Text="Choose the microphone used for dictation." Style="{DynamicResource Description}"/></StackPanel>
                </Grid>
                <ComboBox x:Name="Microphone" HorizontalAlignment="Stretch" Margin="0,18,0,0" AutomationProperties.Name="Microphone"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ToggleButton x:Name="Test" Content="Test microphone" Padding="12,7" Click="TestClick"/>
                    <UniformGrid x:Name="Meter" Grid.Column="1" Rows="1" VerticalAlignment="Center" Height="14" Margin="16,0,0,0" AutomationProperties.Name="Microphone level"/>
                </Grid>
                <TextBlock x:Name="TestError" Style="{DynamicResource Description}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" Style="{DynamicResource Glyph}"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Language" Style="{DynamicResource CardTitle}"/><TextBlock Text="Auto-detect, or give transcription a language hint." Style="{DynamicResource Description}"/></StackPanel>
                </Grid>
                <ComboBox x:Name="LanguagePicker" HorizontalAlignment="Stretch" Margin="0,18,0,0" DisplayMemberPath="Name" SelectedValuePath="Code" AutomationProperties.Name="Language"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
