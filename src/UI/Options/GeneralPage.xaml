<UserControl x:Class="WispX.GeneralPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="General" Style="{DynamicResource PageTitle}"/>
        <Border Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE767;" Style="{DynamicResource Glyph}"/>
                <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Play sounds" Style="{DynamicResource CardTitle}"/><TextBlock Text="Audio cues when dictation starts and stops." Style="{DynamicResource Description}"/></StackPanel>
                <ToggleButton x:Name="SoundsToggle" Grid.Column="2" Style="{DynamicResource Switch}" VerticalAlignment="Center" MinWidth="72" Padding="0" Content="On" AutomationProperties.Name="Play sounds"/>
            </Grid>
        </Border>
        <Border Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE890;" Style="{DynamicResource Glyph}"/>
                <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Show idle pill" Style="{DynamicResource CardTitle}"/><TextBlock Text="Keep a small indicator above the taskbar." Style="{DynamicResource Description}"/></StackPanel>
                <ToggleButton x:Name="PillToggle" Grid.Column="2" Style="{DynamicResource Switch}" VerticalAlignment="Center" MinWidth="72" Padding="0" Content="On" AutomationProperties.Name="Show idle pill"/>
            </Grid>
        </Border>
        <Border Style="{DynamicResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7E8;" Style="{DynamicResource Glyph}"/>
                <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Start with Windows" Style="{DynamicResource CardTitle}"/><TextBlock Text="Have WispX ready when you sign in." Style="{DynamicResource Description}"/></StackPanel>
                <ToggleButton x:Name="StartupToggle" Grid.Column="2" Style="{DynamicResource Switch}" VerticalAlignment="Center" MinWidth="72" Padding="0" Content="On" AutomationProperties.Name="Start with Windows"/>
            </Grid>
        </Border>
        <TextBlock x:Name="Version" Style="{DynamicResource Description}" Margin="4,20,0,0"/>
    </StackPanel>
</UserControl>
