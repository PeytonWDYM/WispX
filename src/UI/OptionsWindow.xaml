<Window x:Class="WispX.OptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WispX Options" ThemeMode="System" Width="820" Height="560" MinWidth="680" MinHeight="460"
        Icon="/Assets/WispX.ico" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" KeyDown="WindowKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Options/OptionsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="16,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fill" CornerRadius="6" Background="{DynamicResource SubtleFillColorTransparentBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="OpenScale"/></Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12,24,12,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <ListBox x:Name="Navigation" Background="{DynamicResource SubtleFillColorTransparentBrush}" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavigationChanged" AutomationProperties.Name="Options pages">
                        <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}"/><TextBlock Text="Account" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                        <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource Glyph}"/><TextBlock Text="Shortcut" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                        <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" Style="{StaticResource Glyph}"/><TextBlock Text="Audio" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                        <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/><TextBlock Text="General" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    </ListBox>
                    <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0" IsHitTestVisible="False">
                        <Border.RenderTransform><TranslateTransform x:Name="IndicatorShift"/></Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Text="WispX" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="16,0,0,24" FontSize="12"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,24">
            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                <ContentControl.RenderTransform><TranslateTransform x:Name="PageShift"/></ContentControl.RenderTransform>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</Window>
