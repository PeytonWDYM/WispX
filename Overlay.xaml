<Window x:Class="WispX.Overlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WispX overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False" UseLayoutRounding="True"
        Width="480" Height="120" Left="-32000" Top="-32000">
    <Grid>
        <Border x:Name="Pill"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Width="44" Height="8" CornerRadius="20" Opacity="0"
                Background="#F20E0E10" BorderBrush="#33FFFFFF" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="Shadow" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.0" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Border x:Name="Glow" CornerRadius="20" Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop x:Name="GlowMid" Color="#22FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas x:Name="Bars" Width="93" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                <TextBlock x:Name="LockIcon" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                           Foreground="#D9FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0"/>
                <Ellipse x:Name="RecDot" Width="6" Height="6" Fill="#FF5A5F" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,15,0" Opacity="0"/>
                <TextBlock x:Name="Msg" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" TextTrimming="CharacterEllipsis"
                           Margin="18,0,18,1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
