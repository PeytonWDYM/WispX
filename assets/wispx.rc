#include <winuser.h>
1 ICON "wispx.ico"
1 RT_MANIFEST "wispx.manifest"
1 VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 1,1,1,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "WispX - hold Ctrl+Win to dictate with ChatGPT\0"
   VALUE "FileVersion", "1.1.1\0"
   VALUE "ProductName", "WispX\0"
   VALUE "ProductVersion", "1.1.1\0"
   VALUE "OriginalFilename", "WispX.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
